# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# Results and outputs
#
# 2026-10-12: this used to be a blanket `results/` + `*.png` + `*.csv`. That
# silently excluded every figure and result JSON from each clone, and two
# figures referenced by paper/main.tex (llama32_3b_layer_signal.png,
# causal_steer_3b.png) were lost that way -- they survived only inside the
# compiled paper/main.pdf and had to be re-extracted from it.
# Only the multi-GB activation caches are ignored now; figures, result JSONs
# and meta.json are tracked on purpose. See results/figures/README.md.
results/cache/*
# keep the old->new directory-name map next to the caches themselves
!results/cache/README.md
results/**/*.pt
results/logs/

# IDE
.idea/
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/

# Secrets / local env
.env
.env.local

# OS
.DS_Store

# Model weights
*.bin
*.pt
*.safetensors
tools/
paper/*.aux
paper/*.bbl
paper/*.out
paper/*.log
paper/compile.log
